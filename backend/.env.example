PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/eventreach
JWT_SECRET=supersecretjwtkey123

# Super Admin bootstrap — consumed only by `npm run seed` (src/utils/seed.ts).
# Provide real values in your local .env / hosting provider secrets, never here.
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=replace-with-a-strong-password-min-12-chars
SUPERADMIN_NAME=Super Admin

# WhatsApp Cloud API — real mode requires BOTH TOKEN and PHONE_ID;
# otherwise the service runs in mock mode (messages are simulated, not sent).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=v22.0
